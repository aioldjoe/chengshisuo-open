# 跑 scripts/setup-line.sh 會互動式填好 LINE 區塊(勿 commit .env.local)
# 說明一律寫在變數的上一行:等號後面不要接註解,scripts/ 的精靈會把它當成值。
# 每個變數的完整說明與設定順序見 SETUP.md。

# --- LINE(setup-line.sh 產出)---
# Bot basic ID(@開頭,加好友連結與首頁 QR 用)
NEXT_PUBLIC_LINE_OA_ID=
# Messaging API channel > Basic settings(驗 webhook 簽章;
# 也是匯出網址簽章的金鑰來源,見 lib/export-url.ts)
LINE_CHANNEL_SECRET=
# Messaging API 分頁 > long-lived token
LINE_CHANNEL_ACCESS_TOKEN=
# LINE Login channel ID(LIFF ID token 驗證的 client_id)
LINE_LOGIN_CHANNEL_ID=
# LIFF 分頁(記錄頁網址的身分容器)
NEXT_PUBLIC_LIFF_ID=
# 選填,LINE OA 後台「加入好友管道」給分享頁的專屬網址;
# 設了 /join?ref=share 就跳它(那條才數得到真的加好友),未設跳一般加好友連結
LINE_ADD_FRIEND_URL_SHARE=
# 選填,同上但給首頁示範記錄頁(/join?ref=demo);兩條迴路的加好友分開數
LINE_ADD_FRIEND_URL_DEMO=
# 選填,同上但給試用記錄頁(/join?ref=trial);試用迴路的加好友單獨數
LINE_ADD_FRIEND_URL_TRIAL=
# 選填,同上但給部落格文章頁(/join?ref=blog);SEO 帶來的加好友單獨數
LINE_ADD_FRIEND_URL_BLOG=

# --- AI ---
# STT(Scribe)
ELEVENLABS_API_KEY=
# 選填,預設 scribe_v1
ELEVENLABS_STT_MODEL=
# google | grok | anthropic(備援);選型看 pnpm bakeoff:llm
AI_PROVIDER=google
# 選填;google 預設 gemini-3.6-flash(2.5 世代對新帳號已停開)、grok 預設 grok-4.3、anthropic 預設 claude-opus-5
AI_MODEL=
# AI_PROVIDER=google 時用
GEMINI_API_KEY=
# AI_PROVIDER=grok 時用(console.x.ai)
XAI_API_KEY=
# AI_PROVIDER=anthropic 時用
ANTHROPIC_API_KEY=
# Cloudflare AI Gateway 名稱;設了三家 AI 呼叫全走 gateway,未設直連(帳號沿用 R2_ACCOUNT_ID)
CF_AI_GATEWAY_ID=
# 選填,gateway 與 R2 不同 Cloudflare 帳號時才填
CF_ACCOUNT_ID=
# 選填,gateway 開 Authenticated Gateway 時的 token
CF_AI_GATEWAY_TOKEN=

# --- 付費(Stripe,掛 海外公司;跑 scripts/setup-deploy.sh 會帶著填)---
# sk_live_/sk_test_;沒設就發不出付款連結(撞額度只會收到「開通中」)
STRIPE_SECRET_KEY=
# whsec_...;Stripe webhook 的簽章金鑰,沒設權益不會自動開通
STRIPE_WEBHOOK_SECRET=
# 輕量 NT$99/月的 price id(price_ 開頭)
STRIPE_PRICE_LITE=
# 標準 NT$399/月的 price id
STRIPE_PRICE_STANDARD=

# --- 儲存 ---
# Turso DB URL(libsql://...);未設時退回檔案系統(本機開發可空)
TURSO_DATABASE_URL=
# Turso DB token(turso db tokens create <db名>)
TURSO_AUTH_TOKEN=
# Cloudflare 帳號 ID;四個 R2 值未設時跳過音檔保存(本機開發可空)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# 選填,會議 JSON 落點,預設 .data/meetings
MEETINGS_DIR=

# --- 本機開發 ---
# 設了就跳過 LIFF、用這個 userId 直通(只在非 production 生效);pnpm seed 也用它
DEV_LINE_USER_ID=

# --- 部署 ---
# 記錄頁連結的網域,如 https://chengshisuo.com
APP_BASE_URL=
# Vercel cron 驗證(選填,本機可空)
CRON_SECRET=
# 額度解鎖碼(選填):使用者在 LINE 傳這串文字(需完全一致),該帳號從此不受額度限制,權益比照付費檔(PDF/分享/記錄頁永久);空=關閉
QUOTA_UNLOCK_CODE=
